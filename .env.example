# ==============================================================================
# FITFORGE AI - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and fill in your actual credentials and settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# APP CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Production (Vercel): set to production and use your deployed frontend URL
# CLIENT_URL=https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# Vercel Cron Job secret (set the same value in Vercel project env vars)
CRON_SECRET=your_random_cron_secret_here

# ------------------------------------------------------------------------------
# DATABASE (MongoDB Connection String)
# ------------------------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/fitforge

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Access Token (short-lived)
JWT_SECRET=your_jwt_access_secret_key_change_in_production
JWT_EXPIRE=15m

# Refresh Token (long-lived)
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRE=7d

# ------------------------------------------------------------------------------
# GOOGLE AI ENGINE (Gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# GOOGLE OAUTH 2.0
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ------------------------------------------------------------------------------
# CLOUDINARY (Media & Image Uploads)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# STRIPE PAYMENTS & SUBSCRIPTIONS
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PRO_PRICE_ID=price_your_pro_plan_id
STRIPE_ELITE_PRICE_ID=price_your_elite_plan_id

# ------------------------------------------------------------------------------
# EMAIL SERVICE (SMTP / Nodemailer)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=noreply@fitforge.ai
EMAIL_FROM_NAME=FitForge AI

# Fallback Email Configuration Keys
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
